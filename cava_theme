# NOSTROMO — cava gradient.
# Not used by Omarchy 4 (it does not ship cava); included for Omarchy 2/3 and
# standalone cava installs. Copy to ~/.config/cava/themes/nostromo or point
# cava's `theme` option at this file.

[color]
gradient = 1
gradient_count = 8
gradient_color_1 = '#2f7a3a'
gradient_color_2 = '#43994f'
gradient_color_3 = '#5fd16b'
gradient_color_4 = '#7dff8a'
gradient_color_5 = '#a6ffae'
gradient_color_6 = '#ffb000'
gradient_color_7 = '#ffd060'
gradient_color_8 = '#ff5f1f'
